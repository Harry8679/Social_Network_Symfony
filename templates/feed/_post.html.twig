<div class="bg-white rounded-xl shadow p-5 space-y-3">
    <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-blue-200 flex items-center justify-center font-bold">
            {{ post.author.username|first|upper }}
        </div>
        <div>
            <p class="font-semibold">{{ post.author.username }}</p>
            <p class="text-xs text-gray-500">
                {{ post.createdAt|date('d/m/Y H:i') }}
            </p>
        </div>
    </div>

    <p>{{ post.content }}</p>

    {% if post.image %}
        <img
            src="{{ asset('uploads/' ~ post.image) }}"
            class="rounded-lg max-h-96 w-full object-cover"
        >
    {% endif %}
</div>