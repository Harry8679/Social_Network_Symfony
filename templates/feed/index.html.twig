{% extends 'base.html.twig' %}

{% block title %}Fil d’actualités{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-100">

    <!-- NAVBAR -->
    <header class="bg-white shadow-sm">
        <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
            <h1 class="text-xl font-bold text-blue-600">SocialApp</h1>

            <div class="flex items-center gap-4">
                <span class="text-gray-700 font-medium">
                    {{ app.user.username }}
                </span>
                <a href="{{ path('app_logout') }}" class="text-sm text-gray-500 hover:text-red-500">
                    Déconnexion
                </a>
            </div>
        </div>
    </header>

    <!-- CONTENT -->
    <div class="max-w-7xl mx-auto px-6 py-6 grid grid-cols-12 gap-6">

        <!-- SIDEBAR -->
        <aside class="col-span-3 bg-white rounded-xl shadow p-4">
            <nav class="space-y-3">
                <a href="{{ path('app_feed') }}"
                   class="block px-4 py-2 rounded-lg bg-blue-100 text-blue-700 font-medium">
                    📰 Fil d’actualités
                </a>
                <a href="#"
                   class="block px-4 py-2 rounded-lg hover:bg-gray-100">
                    👤 Profil
                </a>
                <a href="#"
                   class="block px-4 py-2 rounded-lg hover:bg-gray-100">
                    🤝 Amis
                </a>
                <a href="#"
                   class="block px-4 py-2 rounded-lg hover:bg-gray-100">
                    💬 Messages
                </a>
            </nav>
        </aside>

        <!-- FEED -->
        <main class="col-span-6 space-y-6">

            <!-- CREATE POST -->
            <div class="bg-white rounded-xl shadow p-4">
                {{ form_start(postForm, {
                    action: path('app_post_create'),
                    attr: { class: 'space-y-3' }
                }) }}

                {{ form_widget(postForm.content, {
                    attr: {
                        class: 'w-full border rounded-lg px-4 py-3 text-base focus:ring-2 focus:ring-blue-500',
                        placeholder: 'Exprime-toi, ' ~ app.user.username ~ '…'
                    }
                }) }}

                <div class="flex justify-between items-center">
                    {{ form_widget(postForm.image) }}

                    <button
                        class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">
                        Publier
                    </button>
                </div>

                {{ form_end(postForm) }}
            </div>

            <!-- POSTS -->
            {% for post in posts %}
                <div class="bg-white rounded-xl shadow p-5 space-y-3">

                    <div class="flex items-center gap-3">
                        <div
                            class="w-10 h-10 rounded-full bg-blue-200 flex items-center justify-center font-bold">
                            {{ post.author.username|first|upper }}
                        </div>
                        <div>
                            <p class="font-semibold">{{ post.author.username }}</p>
                            <p class="text-xs text-gray-500">
                                {{ post.createdAt|date('d/m/Y H:i') }}
                            </p>
                        </div>
                    </div>

                    <p class="text-gray-800">
                        {{ post.content }}
                    </p>

                    {% if post.image %}
                        <img
                            src="{{ asset('uploads/' ~ post.image) }}"
                            alt="Image de publication"
                            class="rounded-lg max-h-96 w-full object-cover"
                        >
                    {% endif %}

                    <div class="flex gap-6 text-sm text-gray-500">
                        <button class="hover:text-blue-600">👍 J’aime</button>
                        <button class="hover:text-blue-600">💬 Commenter</button>
                    </div>

                </div>
            {% else %}
                <p class="text-center text-gray-500">
                    Aucune publication pour le moment.
                </p>
            {% endfor %}

        </main>

        <!-- RIGHTBAR -->
        <aside class="col-span-3 space-y-6">

            <div class="bg-white rounded-xl shadow p-4">
                <h2 class="font-semibold mb-3">Suggestions d’amis</h2>
                <ul class="space-y-2 text-sm">
                    <li class="flex justify-between items-center">
                        <span>Jean</span>
                        <button class="text-blue-600 hover:underline">Ajouter</button>
                    </li>
                    <li class="flex justify-between items-center">
                        <span>Marie</span>
                        <button class="text-blue-600 hover:underline">Ajouter</button>
                    </li>
                </ul>
            </div>

            <div class="bg-white rounded-xl shadow p-4">
                <h2 class="font-semibold mb-3">Stories</h2>
                <div class="flex gap-3">
                    <div class="w-16 h-24 bg-gray-200 rounded-lg"></div>
                    <div class="w-16 h-24 bg-gray-300 rounded-lg"></div>
                </div>
            </div>

        </aside>
    </div>
</div>
{% endblock %}