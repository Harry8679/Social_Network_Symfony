{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center bg-gray-100 px-4">
    <div class="w-full max-w-md bg-white rounded-2xl shadow-lg p-8">
        
        <h1 class="text-3xl font-bold text-center mb-2">Créer un compte</h1>
        <p class="text-gray-500 text-center mb-6">
            Rejoins la communauté 🚀
        </p>

        {{ form_start(registrationForm, {
            attr: { class: 'space-y-4' }
        }) }}

        <div>
            {{ form_label(registrationForm.email, null, {
                label_attr: { class: 'block text-sm font-medium text-gray-700' }
            }) }}
            {{ form_widget(registrationForm.email, {
                attr: {
                    class: 'block w-full rounded-lg border border-gray-300 px-4 py-3 text-base shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500'
                }
            }) }}
            {{ form_errors(registrationForm.email) }}
        </div>

        <div>
            {{ form_label(registrationForm.username, null, {
                label_attr: { class: 'block text-sm font-medium text-gray-700' }
            }) }}
            {{ form_widget(registrationForm.username, {
                attr: {
                    class: 'block w-full rounded-lg border border-gray-300 px-4 py-3 text-base shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500'
                }
            }) }}
            {{ form_errors(registrationForm.username) }}
        </div>

        <div>
            {{ form_label(registrationForm.plainPassword.first, null, {
                label_attr: { class: 'block text-sm font-medium text-gray-700' }
            }) }}
            {{ form_widget(registrationForm.plainPassword.first, {
                attr: {
                    class: 'block w-full rounded-lg border border-gray-300 px-4 py-3 text-base shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500'
                }
            }) }}
            {{ form_errors(registrationForm.plainPassword.first) }}
        </div>

        <div>
            {{ form_label(registrationForm.plainPassword.second, null, {
                label_attr: { class: 'block text-sm font-medium text-gray-700' }
            }) }}
            {{ form_widget(registrationForm.plainPassword.second, {
                attr: {
                    class: 'block w-full rounded-lg border border-gray-300 px-4 py-3 text-base shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500'
                }
            }) }}
            {{ form_errors(registrationForm.plainPassword.second) }}
        </div>


        <div class="flex items-start gap-2">
            {{ form_widget(registrationForm.agreeTerms) }}
            <label class="text-sm text-gray-600">
                J’accepte les conditions d’utilisation
            </label>
        </div>

        <button type="submit"
            class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 rounded-lg transition">
            Créer mon compte
        </button>

        {{ form_end(registrationForm) }}

        <p class="text-sm text-center text-gray-500 mt-6">
            Déjà un compte ?
            <a href="{{ path('app_login') }}" class="text-blue-600 hover:underline">
                Se connecter
            </a>
        </p>
    </div>
</div>
{% endblock %}